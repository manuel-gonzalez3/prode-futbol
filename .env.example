# Copiar este archivo como .env y completar. Los valores sirven tal cual para XAMPP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prode
DB_USER=root
DB_PASS=

# URL de la carpeta public/ (para el link del mail de recuperación)
APP_URL=http://localhost/prode/public

# Mails: "log" los escribe en logs/mail.log; "smtp" los manda de verdad
MAIL_MODO=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
